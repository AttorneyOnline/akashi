#pragma once

// Generated by CMake from softwareinformation.h.in - edit the template,
// never the generated copy. The git values are stamped at configure time,
// so they refresh when CMake runs, not on every commit.

#include <QRandomGenerator>
#include <QString>
#include <QStringList>

namespace akashi::software {

inline const QString name = QStringLiteral("@PROJECT_NAME@");
inline const int version_major = @PROJECT_VERSION_MAJOR@;
inline const int version_minor = @PROJECT_VERSION_MINOR@;
inline const int version_patch = @PROJECT_VERSION_PATCH@;
inline const QString version = QStringLiteral("@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@");
inline const QString codename = QStringLiteral("@AKASHI_CODENAME@");
inline const QString release_type = QStringLiteral("@AKASHI_RELEASE_TYPE@");
inline const QString git_branch = QStringLiteral("@AKASHI_GIT_BRANCH@");
inline const QString git_commit = QStringLiteral("@AKASHI_GIT_COMMIT@");

// The whole semver triplet.
inline QString semanticVersion()
{
    return QStringLiteral("%1.%2.%3").arg(version_major).arg(version_minor).arg(version_patch);
}

// What release displays show: the plain version, gaining the patch digit
// once a patch release was cut (1.9, then 1.9.1, 1.9.2, ...).
inline QString releaseNumber()
{
    return version_patch > 0 ? semanticVersion() : version;
}

// The version string the ID packet and --version show: codename (number).
inline QString fullVersion()
{
    return codename + QStringLiteral(" (") + releaseNumber() + QStringLiteral(")");
}

// The Message of the Boot: one of these greets every startup.
inline const QStringList motb = {
    QStringLiteral("100% cuter than competing software."),
    QStringLiteral("Now with 100% less fantacrypt."),
    QStringLiteral("Here lies OPPASS. It knew too much."),
    QStringLiteral("The MC packet still does two jobs. We are sorry."),
    QStringLiteral("Objection! ...Overruled."),
    QStringLiteral("jackfruit is technically a fruit."),
    QStringLiteral("nyaa~"),
    QStringLiteral("tsuserver walked so akashi could run."),
    QStringLiteral("Your Honor, the server is up."),
    QStringLiteral("Zalgo-free since the great stripping."),
    QStringLiteral("Powered by floors, rules and a little spite."),
    QStringLiteral("The decryptor says NOENCRYPT. It always did."),
    QStringLiteral("Court is now in session."),
};

// The screen every boot opens with.
inline QString bootSplash()
{
    const QString l_motb = motb.at(QRandomGenerator::global()->bounded(motb.size()));
    const QString l_line = QStringLiteral("==================================================");
    QStringList l_screen;
    l_screen << l_line
             << QStringLiteral(" %1 %2 \"%3\" - %4").arg(name, releaseNumber(), codename, release_type)
             << QStringLiteral(" %1 @ %2").arg(git_branch, git_commit)
             << QStringLiteral(" \"%1\"").arg(l_motb)
             << l_line;
    return l_screen.join(QStringLiteral("\n"));
}

} // namespace akashi::software
